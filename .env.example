# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# DATABASE_URL: PostgreSQL connection string (wajib untuk auth & langganan).
# Contoh lokal: postgresql://postgres:password@localhost:5432/ugc_saas
DATABASE_URL="postgresql://user:password@host:5432/ugc_saas"

# JWT_SECRET: Kunci signing token login. Ganti dengan string acak panjang!
JWT_SECRET="change-this-to-a-long-random-string"

# MIDTRANS: Server key dari Midtrans Dashboard (Settings > Access Keys).
# Gunakan SB-Midserver-xxx untuk sandbox/development.
MIDTRANS_SERVER_KEY="SB-Midserver-YOUR_SERVER_KEY"

# Set true saat production, false untuk sandbox.
MIDTRANS_IS_PRODUCTION="false"

# Harga langganan bulanan (Rupiah).
SUBSCRIPTION_PRICE_IDR=99000

# VITE_MIDTRANS_CLIENT_KEY: Client key Midtrans untuk Snap popup di frontend.
# Gunakan SB-Mid-client-xxx untuk sandbox.
VITE_MIDTRANS_CLIENT_KEY="SB-Mid-client-YOUR_CLIENT_KEY"
VITE_MIDTRANS_IS_PRODUCTION="false"

# RESEND: Untuk email reminder trial (H-2 & expired).
# Daftar gratis di https://resend.com (100 email/hari di free tier).
RESEND_API_KEY="re_YOUR_API_KEY"
EMAIL_FROM="UGC Scriptwriter <onboarding@resend.dev>"

# APP_URL: URL tempat app ini di-host (opsional).
APP_URL="http://localhost:3000"
